/* Global Settings - Light/Blue Theme */
QWidget {
    background-color: #F5F7FA;
    color: #333333;
    font-family: "Segoe UI", "Tahoma", "Arial", sans-serif;
    font-size: 14px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #E0E0E0;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: #B0BEC5;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #90A4AE;
}

/* QMainWindow & Dialogs */
QMainWindow, QDialog {
    background-color: #F5F7FA;
}

/* QLineEdit & Inputs */
QLineEdit, QDateEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CFD8DC;
    border-radius: 6px;
    padding: 8px;
    color: #333333;
}

QLineEdit:focus, QDateEdit:focus, QComboBox:focus {
    border: 2px solid #2196F3;
    background-color: #FFFFFF;
}

/* Push Buttons (Default) */
QPushButton {
    background-color: #2196F3;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1976D2;
}

QPushButton:pressed {
    background-color: #0D47A1;
}

QPushButton:disabled {
    background-color: #B0BEC5;
    color: #F5F5F5;
}

/* Sidebar Specific */
QWidget#sidebar {
    background-color: #FFFFFF;
    border-left: 1px solid #E0E0E0 !important;
}

/* ModernButton in Dashboard */
QPushButton[class="sidebar_btn"] {
    background-color: transparent;
    color: #546E7A;
    text-align: right;
    padding-right: 20px;
    padding-left: 10px;
    border-radius: 8px;
    border: none;
    font-size: 15px;
}

QPushButton[class="sidebar_btn"]:hover {
    background-color: #E3F2FD;
    color: #1976D2;
}

QPushButton[class="sidebar_btn"]:checked {
    background-color: #E3F2FD;
    color: #1565C0;
    border-right: 4px solid #1565C0; /* Indicator line */
}

/* Tables */
QTableView, QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    gridline-color: #ECEFF1;
    border: 1px solid #CFD8DC;
    selection-background-color: #BBDEFB;
    selection-color: #000000;
}

QHeaderView::section {
    background-color: #ECEFF1;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #2196F3;
    font-weight: bold;
    color: #455A64;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #CFD8DC;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 15px;
    font-weight: bold;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 0 5px;
    color: #1976D2;
}

/* Labels */
QLabel {
    color: #37474F;
}
